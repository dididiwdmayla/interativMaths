# Pergunte ao Nônio (conversa com IA). Todas as variáveis são só de servidor:
# nunca use o prefixo NEXT_PUBLIC_ com elas. Sem a chave, o jogo funciona igual;
# só o botão "Perguntar" não aparece.

# Chave de API da Anthropic (platform.claude.com). Na Vercel: Production e Preview.
ANTHROPIC_API_KEY=

# Modelo da conversa. Padrão: claude-haiku-5-5.
TUTOR_MODELO=

# Opcional, sem padrão: um modelo para uma tentativa quando o principal está sobrecarregado.
TUTOR_MODELO_RESERVA=

# Só fora de produção (ignorada quando NODE_ENV=production). Troca a chamada por uma simulação:
# sobrecarga | sobrecarga-total | rede | resposta | entrega | conta-falsa
TUTOR_SIMULAR=
